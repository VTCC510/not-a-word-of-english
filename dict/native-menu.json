      "flags": "",
      "replacement": "打开 $1"
    },
    {
      "pattern": "^About\\s+(.+)$",
      "flags": "",
      "replacement": "关于 $1"
    },
    {
      "pattern": "^Hide\\s+(.+)$",
      "flags": "",
