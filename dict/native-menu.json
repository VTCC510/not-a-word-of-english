    },
    {
      "pattern": "^Quit\\s+(.+)$",
      "flags": "",
      "replacement": "退出 $1"
    },
    {
      "pattern": "^Search\\s+with\\s+(.+)$",
      "flags": "i",
      "replacement": "使用 $1 搜索"
    },
    {
      "pattern": "^Look\\s+Up\\s+\"([^\"]+)\"$",
      "flags": "",
      "replacement": "查询 \"$1\""
    }
  ],
