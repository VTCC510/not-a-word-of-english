  "menuPatterns": [
    {
      "pattern": "^Open\\s+(Antigravity.*)$",
      "flags": "",
      "replacement": "打开 $1"
    },
    {
      "pattern": "^(\\d+)\\s+agents?\\s+running$",
      "flags": "i",
      "replacement": "$1 个智能体运行中"
    },
    {
      "pattern": "^Pin\\s+Entire\\s+(.+)$",
      "flags": "",
      "replacement": "置顶整个 $1"
    },
    {
      "pattern": "^Move\\s+to\\s+(.+)$",
      "flags": "",
      "replacement": "移动到 $1"
    },
    {
      "pattern": "^Remove\\s+from\\s+(.+)$",
      "flags": "",
      "replacement": "从 $1 中移除"
    },
    {
      "pattern": "^New\\s+(?!Window\\b|Tab\\b|Conversation\\b|File\\b|Folder\\b|Group\\b)(.+)\\.\\.\\.$",
      "flags": "",
      "replacement": "新建 $1..."
    },
    {
      "pattern": "^Open\\s+in\\s+(.+)$",
      "flags": "",
      "replacement": "在 $1 中打开"
    },
    {
      "pattern": "^Open\\s+(.+)$",
      "flags": "",
      "replacement": "打开 $1"
    },
    {
      "pattern": "^About\\s+(.+)$",
      "flags": "",
      "replacement": "关于 $1"
    },
    {
      "pattern": "^Hide\\s+(.+)$",
      "flags": "",
      "replacement": "隐藏 $1"
    },
    {
      "pattern": "^Quit\\s+(.+)$",
      "flags": "",
      "replacement": "退出 $1"
    },
    {
      "pattern": "^Search\\s+with\\s+(.+)$",
      "flags": "i",
      "replacement": "使用 $1 搜索"
    },
    {
      "pattern": "^Look\\s+Up\\s+\"([^\"]+)\"$",
      "flags": "",
      "replacement": "查询 \"$1\""
    },
    {
      "pattern": "^(Side Panel|Browser|Default Browser|Chrome|Edge)\\s+\\(Default\\)$",
      "flags": "",
      "replacement": "$1（默认）"
    }
  ],
